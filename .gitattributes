# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Force specific filetypes to text with LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Treat binary files explicitly
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.ico binary
