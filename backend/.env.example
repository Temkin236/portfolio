# Temkin's World Backend Configuration Environment Variables
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Connection (PostgreSQL with pgvector for production, or SQLite for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/temkins_world
# Or local development:
# DATABASE_URL=sqlite:///./temkins_world.db

# Security & Admin Authentication
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=temkin
ADMIN_PASSWORD_HASH=$2b$12$...

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
